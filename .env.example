# ThiKorben Supabase client configuration
# Copy this file to .env.local and replace the placeholders.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY


# Teacher/demo only. Keep false for production.
# When true, phone/SMS auth uses a local presentation session.
EXPO_PUBLIC_PRESENTATION_MODE=false
